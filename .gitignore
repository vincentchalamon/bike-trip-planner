.agents/*
.claude/settings.local.json
.claude/worktrees/
.mcp.json
# /.env is versioned (dev defaults, no secrets) and read automatically by docker
# compose. Override a value by exporting it in your shell — that is the only
# mechanism: compose reads no `.env.local`. This entry is a safety net for a
# developer who creates one out of Next.js/Symfony habit, so it never gets
# committed even though nothing reads it.
/.env.local
openapi.*
.playwright-mcp/

# npm workspace root: deps are hoisted here (#1012)
/node_modules/

docker-compose.override.yaml
docker-compose.override.yml
compose.override.yaml
compose.override.yml

.docker/osm/data/*
!.docker/osm/data/.gitkeep
.docker/jwt-recette/
.docker/oauth-recette/

coverage/
.lighthouseci/
.mkdocs/

# Tracked on purpose: the single migration baseline schema. A developer's global
# core.excludesFile may ignore *.sql; this negation keeps the baseline committed.
!api/migrations/schema/baseline_schema.sql
