# Docker Compose environment — auto-loaded from the project directory.
#
# Versioned on purpose: DEV defaults only, never a secret. Production reads a
# separate file rendered by Ansible at /etc/bike-trip-planner/app.env, passed
# with `--env-file` (which also stops compose auto-loading this one).
#
# Override locally by exporting the variable in your shell — it wins over this
# file. `make start` already does that for the fail-closed secrets.

# --- Identity ----------------------------------------------------------------
# The DNS zone. Single source for every origin: SERVER_NAME, FRONTEND_URL,
# TRUSTED_HOSTS, CORS_ALLOW_ORIGIN, DEFAULT_URI, Mercure, the Traefik router and
# the pr-<n>.${DOMAIN} previews.
DOMAIN=localhost

# Transactional sender, and the GDPR/legal contact the PWA and the app display.
# Deliberately NOT derived from DOMAIN: `noreply@localhost` has no TLD, and in
# production the sending domain may differ from the served one (SPF/DKIM).
MAILER_SENDER_EMAIL=noreply@bike-trip-planner.com
CONTACT_EMAIL=contact@bike-trip-planner.com

# --- Ports -------------------------------------------------------------------
# Set these when 80/443 are already taken on the host.
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Runtime -----------------------------------------------------------------
#WORKER_REPLICAS=2
#MIGRATIONS_ON_BOOT=true
# Whole countries the Valhalla graph is built from (`make routing-build <slug>`).
#ROUTING_SLUGS=

# --- External data sources (optional; each step is skipped when unset) --------
#DATATOURISME_FLUX_ID=
#DATATOURISME_APP_KEY=
#OPENAGENDA_DATASET=
#OPENAGENDA_API_KEY=

# --- Observability (optional; empty disables) --------------------------------
#SENTRY_DSN=
#NEXT_PUBLIC_SENTRY_DSN=
#APP_RELEASE=
#NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
#NEXT_PUBLIC_PLAUSIBLE_SRC=

# --- Android App Links (set once the signed app exists) ----------------------
#ANDROID_APP_PACKAGE=
#ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Secrets ------------------------------------------------------------------
# NOT here, on purpose. APP_SECRET, MERCURE_JWT_KEY, REFRESH_TOKEN_ENC_KEY,
# ACCESS_REQUEST_HMAC_SECRET, JWT_* and the DB credentials must stay unset so the
# prod entrypoint guards fail closed. `make start` supplies local placeholders.
