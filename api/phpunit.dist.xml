<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnPhpunitDeprecations="true"
         displayDetailsOnPhpunitNotices="true"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <env name="KERNEL_CLASS" value="App\Kernel" force="true" />
        <!-- Override environment variables set in Docker Compose -->
        <env name="MESSENGER_TRANSPORT_DSN" value="in-memory://" force="true" />
        <env name="MESSENGER_FAILED_DSN" value="in-memory://" force="true" />

        <env name="MAILER_DSN" value="null://null"/>
        <!-- Fixed sender so the From assertion does not depend on the ambient env. -->
        <env name="MAILER_SENDER_EMAIL" value="noreply@phpunit.example" force="true"/>
        <env name="ACCESS_REQUEST_HMAC_SECRET" value="test-hmac-secret-for-phpunit" force="true"/>
        <!-- Match the test JWT keypair passphrase (CI generates keys with `-pass pass:test`;
             neutralises the empty JWT_PASSPHRASE injected by compose.dev.yaml). -->
        <env name="JWT_PASSPHRASE" value="test" force="true"/>

        <!-- ###+ symfony/lock ### -->
        <!-- Choose one of the stores below -->
        <!-- postgresql+advisory://db_user:db_password@localhost/db_name -->
        <env name="LOCK_DSN" value="flock"/>
        <!-- ###- symfony/lock ### -->

        <!-- ###+ symfony/ai-anthropic-platform ### -->
        <env name="ANTHROPIC_API_KEY" value=""/>
        <!-- ###- symfony/ai-anthropic-platform ### -->

        <!-- ###+ symfony/ai-gemini-platform ### -->
        <env name="GEMINI_API_KEY" value=""/>
        <!-- ###- symfony/ai-gemini-platform ### -->

        <!-- ###+ symfony/ai-open-ai-platform ### -->
        <env name="OPENAI_API_KEY" value=""/>
        <!-- ###- symfony/ai-open-ai-platform ### -->

        <!-- The authorization server's own keypair, in its own directory. The Flex recipe
             points these at config/jwt, i.e. at Lexik's keys; sharing them would make a PWA
             session token verify on /mcp and an agent token verify on the REST API. The
             separation is the anti-passthrough property (ADR-079), so it is asserted at boot
             and exercised by a test — not left to whoever copies these lines next. -->
        <env name="OAUTH_PRIVATE_KEY" value="%kernel.project_dir%/config/oauth/private.pem"/>
        <env name="OAUTH_PUBLIC_KEY" value="%kernel.project_dir%/config/oauth/public.pem"/>
        <env name="OAUTH_PASSPHRASE" value="test"/>
        <env name="OAUTH_ENCRYPTION_KEY" value="7085db3dc54b2106eaef26865fcfd516"/>
    </php>

    <testsuites>
        <testsuite name="API Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="false"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <deprecationTrigger>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <coverage>
        <report>
            <clover outputFile="coverage/clover.xml"/>
            <html outputDirectory="coverage/html"/>
        </report>
    </coverage>

    <extensions>
        <bootstrap class="Zenstruck\Foundry\PHPUnit\FoundryExtension" />
    </extensions>
</phpunit>
