# https://phpstan.org/blog/what-is-bleeding-edge
includes:
	- vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 9
    treatPhpDocTypesAsCertain: false
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - config/reference.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: utils/phpstan/console-loader.php
    banned_code:
        nodes:
            # enable detection of echo
            - type: Stmt_Echo
              functions: null
            # enable detection of eval
            - type: Expr_Eval
              functions: null
            # enable detection of die/exit
            - type: Expr_Exit
              functions: null
            # enable detection of a set of functions
            - type: Expr_FuncCall
              functions:
                  - dd
                  - debug_backtrace
                  - dump
                  - exec
                  - passthru
                  - phpinfo
                  - print_r
                  - proc_open
                  - shell_exec
                  - system
                  - var_dump
            # enable detection of print statements
            - type: Expr_Print
              functions: null
            # enable detection of shell execution by backticks
            - type: Expr_ShellExec
              functions: null
    ignoreErrors:
        - identifier: argument.type
          path: tests/Functional/Auth/*
        - identifier: missingType.iterableValue
          path: tests/Functional/Auth/*
        # `.env.local.php` is produced by `composer dump-env prod` (prod image
        # build only) and is gitignored, so it is legitimately absent in dev, in
        # CI and in a fresh worktree. The `@include` in the Symfony skeleton's
        # bootstrap is written to tolerate exactly that. Surfaced by the
        # include.fileNotFound rule, new in PHPStan 2.2.14's bleeding edge.
        - identifier: include.fileNotFound
          path: config/bootstrap.php
