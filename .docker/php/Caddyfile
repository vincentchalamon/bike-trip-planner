{
    {$CADDY_GLOBAL_OPTIONS}

    # No admin API (SEC-19): it would let anything in the container (or able to
    # reach its loopback) rewrite the whole server config. Nothing uses it; the
    # healthchecks go through the site itself (compose.yaml).
    admin off

    # Keep the inbound X-Forwarded-For chain when proxying to the PWA: without a
    # trusted peer Caddy replaces it with Traefik's IP, so the BFF could not relay
    # the client IP to the backend. Same private ranges as TRUSTED_PROXIES. Strict
    # = read right to left, so Caddy's own client_ip ignores prepended values too.
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }

    frankenphp {
        {$FRANKENPHP_CONFIG}

        worker {
            file ./public/index.php

            {$FRANKENPHP_WORKER_CONFIG}
        }
    }
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
    # Access logging. The directive has to stay: dropping it turns access logging
    # off and takes the X-Request-Id correlation trail below with it.
    #
    # The filter is defence in depth. No emailed link puts a credential where the
    # server sees it any more (the verify tokens ride in the fragment), but a share
    # code is still a path segment, an old link may still be clicked, and the same
    # values would ride as Referer. Mirrors App\Logger\LogRedactor; RE2 has no
    # lookahead, hence one pattern per shape. The output stays JSON.
    log {
        format filter {
            wrap json
            request>uri multi_regexp {
                regexp "(/(?:auth/verify|account/email-change/verify|s)/)[^/?#.{]+" "${1}[redacted]"
                regexp "(/users/me/device-tokens/)[^/?#]*:[^/?#]*" "${1}[redacted]"
                regexp "(?i)([?&](?:email|signature|token|share_token|access_token|refresh_token|code|state|apikey|api_key|key|password|lat|lon|lng|latitude|longitude)=)[^&#]*" "${1}[redacted]"
            }
            request>headers>Referer multi_regexp {
                regexp "(/(?:auth/verify|account/email-change/verify|s)/)[^/?#.{]+" "${1}[redacted]"
                regexp "(?i)([?&](?:email|signature|token|share_token|access_token|refresh_token|code|state|apikey|api_key|key|password|lat|lon|lng|latitude|longitude)=)[^&#]*" "${1}[redacted]"
            }
        }
    }

    root /app/public

    # Native mobile clients opt out of compression. React Native's okhttp advertises
    # `zstd, br, gzip` but only transparently decodes gzip it added itself, so a
    # zstd/br body reaches the app raw and is read as Latin-1 — UTF-8 `é` (C3 A9)
    # becomes "Ã©", mojibaking accented trip titles on the "Mes voyages" list. The
    # native stack overrides the forbidden `Accept-Encoding` request header, so the
    # app instead sends `X-Client-Platform: mobile` (a custom header okhttp keeps).
    # We rewrite its incoming Accept-Encoding to `identity` here, BEFORE `encode`
    # runs (`request_header` is ordered before `encode` in Caddy's handler chain, so
    # `encode` reads the rewritten value and finds no acceptable encoding -> serves
    # it uncompressed). Web/PWA clients decode zstd/br fine and keep compression.
    @mobile header X-Client-Platform mobile
    request_header @mobile Accept-Encoding identity

    # Compress responses. JSON (application/json, application/ld+json) and GPX
    # (application/gpx+xml) are included so browser/PWA clients get compressed
    # transfers on the large geometry payloads too — GET /trips/{id}/route (ADR-057)
    # and the GPX exports (/s/{code}.gpx, stage GPX). Native mobile is excluded via
    # the Accept-Encoding rewrite above, not by dropping a content-type here.
    # text/event-stream (Mercure SSE) is deliberately NOT whitelisted: it must never
    # be buffered/compressed, for any client.
    encode zstd br gzip {
        match {
            header Content-Type text/html*
            header Content-Type text/css*
            header Content-Type text/javascript*
            header Content-Type application/javascript*
            header Content-Type text/x-component*
            header Content-Type image/svg+xml*
            header Content-Type application/wasm*
            header Content-Type application/json*
            header Content-Type application/ld+json*
            header Content-Type application/gpx+xml*
        }
    }

    # Limit request body to 30 MB (GPX upload)
    request_body {
        max_size 30MB
    }

    # Correlation ID (#485): default to a generated UUID, and trust an inbound
    # X-Request-Id only when it matches the safe charset (mirrors
    # App\EventListener\RequestIdListener::isSafe), then forward that bounded
    # value upstream. The value cannot be attacker-controlled (length/charset
    # bounded, no header smuggling). The response header is set by the PHP
    # listener alone (single source of truth, also covers traffic that bypasses
    # the edge: ApiTestCase, internal sub-requests, workers).
    vars correlation_id {http.request.uuid}
    @valid_request_id header_regexp X-Request-Id ^[A-Za-z0-9_-]{8,128}$
    vars @valid_request_id correlation_id {http.request.header.X-Request-Id}
    request_header X-Request-Id "{vars.correlation_id}"

    # Mercure hub, protocol 1.0, as embedded in the upstream FrankenPHP binary
    # (mercure/caddy v1.1.x since FrankenPHP v1.13); see the ADR-037 addenda.
    #
    # Deliberately NOT in `protocol_version_compatibility` mode: it weakens
    # access-token validation to keep 0.x clients working, and every client here
    # (PWA, mobile, the backend's own subscription check) speaks 1.0.
    mercure {
        # Named because this site block is served twice when SERVER_NAME lists an https and
        # an http address (`localhost, http://php`): mercure/caddy v1.1 allows a single
        # unnamed hub per configuration, and the two handlers share one transport by name.
        name bike-trip-planner
        # Transport to use (default to Bolt)
        transport bolt {
            path /data/mercure.db
        }
        # Trusted token issuer: the identifier MUST equal the `iss` claim the
        # backend mints (mercure.jwt.claims.iss, config/packages/mercure.php).
        # The algorithm is left to the module's default (HS256 for a raw secret):
        # passing an unset {env.*} placeholder would hand it an empty argument.
        issuer {$MERCURE_ISSUER} {
            publisher {
                jwt {env.MERCURE_PUBLISHER_JWT_KEY}
            }
            subscriber {
                jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
            }
        }
        # Expected `aud` of every access token. Pinned rather than derived from
        # the request, because the backend publishes through the internal
        # MERCURE_URL (http://php/...) while browsers subscribe on the public
        # one — an unpinned hub would expect a different audience per origin.
        resource_identifier {$MERCURE_PUBLIC_URL:https://localhost/.well-known/mercure}
        # No `anonymous`: every update is published private (TripUpdatePublisher),
        # so a subscriber without a token could never receive anything, and the
        # hub now answers it 401 instead of holding a connection open (SEC-21).
        # The subscription API stays: MercureSubscriptionChecker reads it with a
        # short-lived server-side token.
        subscriptions
        # Extra directives. Careful: since 1.0 an unknown directive here is a
        # fatal config error rather than a silent no-op (`ui` became `debugger`,
        # `demo` became `playground`).
        {$MERCURE_EXTRA_DIRECTIVES}
    }

    # Add links to the API docs and to the Mercure Hub if not set explicitly (e.g. the PWA)
    header ?Link `</docs.jsonld>; rel="http://www.w3.org/ns/hydra/core#apiDocumentation", </.well-known/mercure>; rel="mercure"`
    # Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
    header ?Permissions-Policy "browsing-topics=()"

    # Security headers (audit 35.2 SEC-002..004). Set site-wide; safe for both the
    # PWA documents and the API responses. CSP (SEC-001) is scoped to the PWA in
    # the route block below so it never touches the API docs UI.
    header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
    header ?X-Frame-Options "DENY"
    header ?X-Content-Type-Options "nosniff"
    # strict-origin, not strict-origin-when-cross-origin: nothing here reads a
    # same-origin Referer, and a full one would carry the page path (a share code)
    # into the access log of every request the page makes. Cross-origin (map
    # tiles, whose usage policies ask for a Referer) still get the origin.
    header ?Referrer-Policy "strict-origin"
    header ?X-Robots-Tag "noindex, nofollow"

    route {
        # Matches requests for HTML documents, for static files and for Next.js files,
        # except for known API paths and paths with extensions handled by API Platform.
        # /oauth/authorize is excluded because it is the one BACKEND endpoint a browser
        # navigates to directly (ADR-079): it sends `Accept: text/html` like any page and
        # would otherwise be proxied to Next.js, which has no such route. The consent SCREEN
        # it redirects to (/oauth/consent/<handle>) is a PWA page and stays on this side; the
        # API resource behind that screen is /oauth/pending-authorizations/*, named so the
        # two can never be told apart by a single letter.
        # /api/auth/* are the Next.js BFF auth route handlers (ADR-053), hit by JSON fetch
        # (Accept: */*) so they miss the text/html branch and must be forced to the PWA.
        # Scoped to /api/auth/* on purpose: the backend serves /api/health and /api/healthz
        # (HealthController), which must stay on PHP.
        @pwa expression `(
                header({'Accept': '*text/html*'})
                && !path(
                    '/docs*', '/graphql*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*',
                    '/oauth/authorize', '/oauth/token', '/.well-known/oauth-protected-resource*',
                    '/.well-known/oauth-authorization-server',
                    '*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml'
                )
            )
            || path('/favicon.ico', '/manifest.json', '/robots.txt', '/sitemap*', '/_next*', '/__next*', '/vendor/*', '/.well-known/assetlinks.json')
            || query({'_rsc': '*'})
            || path('/api/auth/*')`

        # Content-Security-Policy (SEC-14). The enforced policy of the HTML documents,
        # script-src included, is set by Next.js (pwa/src/proxy.ts): it carries a fresh
        # nonce per request, which Caddy cannot know. Setting a second script-src here
        # would be intersected with it, so this one only covers the non-fetch directives,
        # and only where the PWA did not answer with a policy of its own (`?` = set if
        # absent): static files, the BFF route handlers, the MapLibre worker scripts.
        header @pwa ?Content-Security-Policy "object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

        # Comment the following line if you don't want Next.js to catch requests for HTML documents.
        # In this case, they will be handled by the PHP app.
        # Trusting the peer would also pass the upstream X-Forwarded-Host/-Proto
        # through; pin them to what Caddy sent before, only XFF is meant to change.
        reverse_proxy @pwa http://{$PWA_UPSTREAM} {
            header_up X-Forwarded-Host {hostport}
            header_up X-Forwarded-Proto {scheme}
        }

        @phpRoute {
            not path /.well-known/mercure*
            not file {path}
        }
        rewrite @phpRoute index.php

        @frontController path index.php
        php @frontController

        file_server {
            hide *.php
        }
    }
}
