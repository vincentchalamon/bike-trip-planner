# Copy to `inventory.ini` and fill in.
#
# Web traffic arrives over the Cloudflare Tunnel only, but the GHA deploy jobs
# SSH straight to the VM's public IP (port 22, see README "Restrict SSH").
# Options for the `ansible_host` / connection:
#
#   * Direct: ansible_host=<public IP>, from an address in ssh_allowed_cidrs.
#   * Through the tunnel (ssh_tunnel_hostname set in group_vars, plus a
#     Cloudflare Access "ssh" application on that hostname):
#       ansible_ssh_common_args='-o ProxyCommand="cloudflared access ssh --hostname %h"'
#       ansible_host=ssh.example.com
#
# ansible_user must not be root: the hardening role turns PermitRootLogin off
# and only lets ssh_operator_users (default: ansible_user) and the deploy users in.
#
[btp]
btp-prod ansible_host=CHANGE_ME ansible_user=ubuntu

[btp:vars]
# ansible_ssh_common_args='-o ProxyCommand="cloudflared access ssh --hostname %h"'
