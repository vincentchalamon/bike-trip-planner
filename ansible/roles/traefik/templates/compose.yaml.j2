# {{ ansible_managed }}
# Traefik reverse proxy. No published host ports -> no open public port on the
# VM (plan W5). App stacks attach to `edge` and declare their routes with
# Traefik labels (Host(`www.${DOMAIN}`), Host(`pr-N.${DOMAIN}`)).
services:
  traefik:
    image: {{ traefik_image }}
    restart: unless-stopped
    command:
      - --configFile=/etc/traefik/traefik.yml
    # Both edge sides: prod php is on `edge`, preview php on `edge-preview`;
    # `docker-api` reaches the socket proxy only.
    networks:
      - edge
      - edge-preview
      - docker-api
    depends_on:
      - socket-proxy
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    volumes:
      - {{ traefik_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro

  # The Docker socket is root on the host, `:ro` or not. Traefik reads the
  # Engine API through this proxy instead (SEC-19), which answers GET on
  # /containers, /events, /version and /_ping and refuses everything else
  # (POST=0: no create, exec, start or stop).
  socket-proxy:
    image: {{ docker_socket_proxy_image }}
    restart: unless-stopped
    environment:
      CONTAINERS: "1"
      EVENTS: "1"
      PING: "1"
      VERSION: "1"
      POST: "0"
    networks:
      - docker-api
    read_only: true
    # The entrypoint renders haproxy.cfg into /tmp at start.
    tmpfs:
      - /run
      - /tmp
    security_opt:
      - no-new-privileges:true
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro

networks:
  edge:
    external: true
  edge-preview:
    external: true
  # Traefik <-> socket proxy only; `internal`: no route out.
  docker-api:
    internal: true
