# {{ ansible_managed }}
# Traefik reverse proxy. No published host ports -> no open public port on the
# VM (plan W5). App stacks attach to `edge` and declare their routes with
# Traefik labels (Host(`www.${DOMAIN}`), Host(`pr-N.${DOMAIN}`)).
services:
  traefik:
    image: {{ traefik_image }}
    restart: unless-stopped
    command:
      - --configFile=/etc/traefik/traefik.yml
    networks:
      - edge
    volumes:
      # Traefik's Docker provider needs the socket to read container labels.
      # `:ro` does NOT restrict the Docker API — a read-only socket mount still
      # grants full Engine access (equivalent to host root). Accepted single-
      # tenant tradeoff for the beta VM. TODO (post-beta hardening): put a
      # least-privilege docker-socket-proxy (tecnativa/docker-socket-proxy) in
      # front, exposing only the containers/events endpoints Traefik reads.
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ traefik_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro

networks:
  edge:
    external: true
