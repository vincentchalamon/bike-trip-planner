# {{ ansible_managed }}
# Traefik static config — single reverse proxy, Docker provider, plain HTTP.
# NO ACME: TLS is terminated at Cloudflare's edge; the origin is reached only
# through the Cloudflare Tunnel (plan W5). Traefik publishes no host port; it is
# reached by cloudflared over the `edge` docker network.

entryPoints:
  web:
    address: ":80"
    # cloudflared sets X-Forwarded-For to the real client IP; trust it from the
    # `edge` subnet only (cloudflared's network), so Traefik preserves it
    # end-to-end (plan W5.2). A preview container reaching Traefik over
    # edge-preview is not trusted: its X-Forwarded-For is replaced.
    forwardedHeaders:
      trustedIPs:
        - 127.0.0.1/32
        - {{ edge_subnet }}

providers:
  docker:
    exposedByDefault: false
    # Default network to reach a container on. Preview php overrides it with the
    # `traefik.docker.network=edge-preview` label.
    network: edge

api:
  dashboard: false

log:
  level: INFO

# No query string and no path: a URL can carry a credential (a share code is a
# path segment; an old emailed link had its token there). The app's Caddy, right
# behind, logs the same request with those parts redacted and the X-Request-Id
# that ties it to the application logs. Headers are dropped by default already.
accessLog:
  fields:
    names:
      RequestPath: drop
    queryParameters:
      defaultMode: drop
