#!/usr/sbin/nft -f
# {{ ansible_managed }}
# Host INPUT filter only. Container traffic is routed (FORWARD), never sees this
# chain, and Docker's own iptables-nft tables are left alone: no `flush ruleset`.
# Re-applying is atomic: the table is declared, deleted and rebuilt in one batch.
table inet btp_host
delete table inet btp_host

table inet btp_host {
  set ssh_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if hardening_ssh_v4 | length > 0 %}
    elements = { {{ hardening_ssh_v4 | join(', ') }} }
{% endif %}
  }

  set ssh_v6 {
    type ipv6_addr
    flags interval
    auto-merge
{% if hardening_ssh_v6 | length > 0 %}
    elements = { {{ hardening_ssh_v6 | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    meta l4proto icmp accept
    meta l4proto ipv6-icmp accept
    # DHCP leases (OCI hands the instance address out by DHCP).
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    tcp dport 22 ip saddr @ssh_v4 accept
    tcp dport 22 ip6 saddr @ssh_v6 accept
{% if ssh_tunnel_hostname | length > 0 %}
    # cloudflared (edge network) -> sshd, for the Access SSH application.
    tcp dport 22 ip saddr {{ edge_subnet }} accept
{% endif %}
  }
}
