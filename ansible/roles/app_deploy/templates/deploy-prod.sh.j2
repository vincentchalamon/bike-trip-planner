#!/usr/bin/env bash
# {{ ansible_managed }}
# Prod deploy hook, and the rollback procedure: `deploy-prod.sh <previous tag>`.
# Does what GHA `deploy-prod` runs over SSH. Checking out the tag is what selects
# the release: btp-compose derives the image tags from it.
set -euo pipefail

cd "{{ app_dir }}"
TAG="${1:?usage: deploy-prod.sh <tag>}"

git fetch --tags --prune --force
git checkout --force "refs/tags/${TAG}"

/usr/local/bin/btp-compose pull
/usr/local/bin/btp-compose up -d
