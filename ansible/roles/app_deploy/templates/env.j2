# {{ ansible_managed }}
# Prod runtime env for `docker compose -p prod`, passed with
# `--env-file {{ etc_dir }}/app.env`. Rendered OUTSIDE {{ app_dir }} because
# deploy-prod force-checks-out the tag there, which would restore the repo's
# versioned `.env` (dev defaults) over this file on every deploy.
# ALL runtime secrets were relocated here from Coolify (deployment plan, W9).
#
# NOTE: docker compose interpolates `$` in this file. If any secret value
# contains a literal `$`, double it as `$$` in vault.yml.
# DOMAIN is the DNS zone. Every origin (SERVER_NAME, FRONTEND_URL,
# MERCURE_PUBLIC_URL, TRUSTED_HOSTS, CORS, the Traefik router) derives from it in
# deploy/prod/compose.yaml — setting them here too would be dead weight, since the
# overlay's `environment:` block wins over this file.
DOMAIN={{ domain }}
APP_ENV=prod
TRUSTED_PROXIES={{ trusted_proxies }}

# --- Mercure / JWT / tokens / HMAC ---
APP_SECRET={{ vault_app_secret }}
MERCURE_JWT_KEY={{ vault_mercure_jwt_key }}
JWT_PASSPHRASE={{ vault_jwt_passphrase }}
JWT_PRIVATE_KEY_PATH={{ jwt_dir }}/private.pem
JWT_PUBLIC_KEY_PATH={{ jwt_dir }}/public.pem
REFRESH_TOKEN_ENC_KEY={{ vault_refresh_token_enc_key }}
ACCESS_REQUEST_HMAC_SECRET={{ vault_access_request_hmac_secret }}

# --- FCM push (single-line JSON) ---
FCM_SERVICE_ACCOUNT_JSON={{ vault_fcm_service_account_json }}

# --- Mailer (Brevo) ---
MAILER_DSN={{ vault_mailer_dsn }}
# Sender of every transactional email, and the GDPR/legal contact the PWA shows.
# Independent of DOMAIN: the sending domain may differ from the served one (SPF/DKIM).
MAILER_SENDER_EMAIL={{ mailer_sender_email }}
CONTACT_EMAIL={{ contact_email }}

# --- PG-app (per-stack) ---
DATABASE_USERNAME={{ vault_database_username }}
DATABASE_PASSWORD={{ vault_database_password }}
DATABASE_NAME={{ vault_database_name }}

# --- PG-reference (shared, read-only from the app) + Valhalla ---
REFERENCE_DATABASE_URL={{ vault_reference_database_url }}
VALHALLA_BASE_URI={{ valhalla_base_uri }}

# --- Observability ---
SENTRY_DSN={{ vault_sentry_dsn }}
NEXT_PUBLIC_SENTRY_DSN={{ vault_next_public_sentry_dsn }}
APP_RELEASE={{ app_release }}

# --- Images (arm64, GHCR) ---
PHP_IMAGE={{ php_image }}
PWA_IMAGE={{ pwa_image }}
